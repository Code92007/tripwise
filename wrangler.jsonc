{
  "name": "tripwise-routes",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "secrets": { "required": ["AMAP_WEB_KEY"] },
  "ratelimits": [{
    "name": "ROUTE_LIMIT",
    "namespace_id": "1001",
    "simple": { "limit": 2, "period": 10 }
  }],
  "vars": {
    "ALLOWED_ORIGINS": "https://code92007.github.io,http://localhost:5173,http://127.0.0.1:5173,https://localhost"
  }
}
